  "scenes": [],
  "deleted_ids": [],
  "subtitles": [
    {
      "id": "trans_0",
      "start": 0,
      "end": 1.06,
      "text": "Tốt, tốt, tốt"
    },
    {
      "id": "trans_1",
      "start": 1.06,
      "end": 2.8,
      "text": "Xảo Nhi quả không hổ là con gái do ta dạy dỗ"
    },
    {
      "id": "trans_2",
      "start": 2.8,
      "end": 4.12,
      "text": "Thật là làm rạng danh nhà họ Thẩm"
    },
    {
      "id": "trans_3",
      "start": 4.64,
      "end": 5.46,
      "text": "Cha quá khen rồi"
    },
    {
      "id": "trans_4",
      "start": 5.46,
      "end": 7.22,
      "text": "Con gái cũng chỉ vì nghĩ cho gia tộc thôi"
    },
    {
      "id": "trans_5",
      "start": 7.76,
      "end": 9.06,
      "text": "Chờ khi con gái trở\nthành phu nhân họ Mộ Dung"
    },
    {
      "id": "trans_6",
      "start": 9.06,
      "end": 10.82,
      "text": "Ngày sau nhất định \nmỗi năm một thịnh vượng hơn"
    },
    {
      "id": "trans_7",
      "start": 10.82,
      "end": 12.34,
      "text": "Mưu cầu phúc lợi cho gia tộc"
    },
    {
      "id": "trans_8",
      "start": 12.72,
      "end": 13.32,
      "text": "Tỷ tỷ"
    },
    {
      "id": "trans_9",
      "start": 13.84,
      "end": 15.04,
      "text": "Muội nói có đúng không?"
    },
    {
      "id": "trans_10",
      "start": 16.32,
      "end": 17.4,
      "text": "Muội muội thật có phúc"
    },
    {
      "id": "trans_11",
      "start": 17.4,
      "end": 18.74,
      "text": "Ta đương nhiên là mừng cho muội"
    },
    {
      "id": "trans_12",
      "start": 18.74,
      "end": 19.78,
      "text": "Giữ gìn thân phận của muội"
    },
    {
      "id": "trans_13",
      "start": 19.78,
      "end": 21.74,
      "text": "Giờ đây vận mệnh tốt đẹp\ncủa tỷ đã bị ta cướp mất"
    },
    {
      "id": "trans_14",
      "start": 21.74,
      "end": 22.74,
      "text": "Cả đời này"
    },
    {
      "id": "trans_15",
      "start": 22.74,
      "end": 24.64,
      "text": "Ta nhất định sẽ không để\ntỷ vượt lên trên ta nữa"
    },
    {
      "id": "trans_16",
      "start": 27.22,
      "end": 28.18,
      "text": "Xảo Nhi mau nhìn kìa"
    },
    {
      "id": "trans_17",
      "start": 28.18,
      "end": 29.84,
      "text": "Mộ Dung công tử."
    },
    {
      "id": "trans_18",
      "start": 29.84,
      "end": 30.66,
      "text": "đang nhìn con kìa"
    },
    {
      "id": "trans_19",
      "start": 38.9,
      "end": 39.5,
      "text": "Đó không phải"
    },
    {
      "id": "trans_20",
      "start": 41.28,
      "end": 41.72,
      "text": "Hoàng thượng"
    },
    {
      "id": "trans_21",
      "start": 43.68,
      "end": 44.12,
      "text": "Chủ tử"
    },
    {
      "id": "trans_22",
      "start": 44.12,
      "end": 45.28,
      "text": "Người mặc như vậy ra khỏi cung"
    },
    {
      "id": "trans_23",
      "start": 45.28,
      "end": 46.5,
      "text": "Thái hậu mà biết được"
    },
    {
      "id": "trans_24",
      "start": 46.5,
      "end": 47.78,
      "text": "Mẫu hậu ngày nào cũng giam lỏng trẫm"
    },
    {
      "id": "trans_25",
      "start": 47.78,
      "end": 49.08,
      "text": "Trẫm chỉ có thể ra khỏi\ncung để tìm chút thanh tịnh"
    },
    {
      "id": "trans_26",
      "start": 49.5,
      "end": 50.44,
      "text": "Nhân cơ hội này"
    },
    {
      "id": "trans_27",
      "start": 50.44,
      "end": 51.9,
      "text": "Trải nghiệm cuộc sống của dân thường"
    },
    {
      "id": "trans_28",
      "start": 51.9,
      "end": 53.36,
      "text": "Chủ tử vốn yêu dân như con"
    },
    {
      "id": "trans_29",
      "start": 53.36,
      "end": 54.58,
      "text": "Nhưng người mặc bộ này"
    },
    {
      "id": "trans_30",
      "start": 55.12,
      "end": 56.46,
      "text": "Bộ y phục này tuy không sang"
    },
    {
      "id": "trans_31",
      "start": 56.46,
      "end": 58.04,
      "text": "nhưng lẫn trong đám dân\nthường mới không gây chú ý"
    },
    {
      "id": "trans_32",
      "start": 58.04,
      "end": 58.68,
      "text": "Chẳng lẽ"
    },
    {
      "id": "trans_33",
      "start": 58.68,
      "end": 59.84,
      "text": "người muốn trẫm mặc long bào"
    },
    {
      "id": "trans_34",
      "start": 59.84,
      "end": 60.56,
      "text": "rồi ra ngoài dạo chơi sao?"
    },
    {
      "id": "trans_35",
      "start": 67.46,
      "end": 68.1,
      "text": "Chủ tử"
    },
    {
      "id": "trans_36",
      "start": 68.1,
      "end": 68.88,
      "text": "Ngài không sao chứ?"
    },
    {
      "id": "trans_37",
      "start": 68.88,
      "end": 69.48,
      "text": "Mắt ngươi mù à!"
    },
    {
      "id": "trans_38",
      "start": 69.48,
      "end": 70.14,
      "text": "Không mở mắt ra à?"
    },
    {
      "id": "trans_39",
      "start": 70.14,
      "end": 70.48,
      "text": "Đi nhanh thôi."
    },
    {
      "id": "trans_40",
      "start": 70.48,
      "end": 71.54,
      "text": "Hai vị tiểu thư nhà họ Thẩm"
    },
    {
      "id": "trans_41",
      "start": 71.54,
      "end": 72.2,
      "text": "đang ném cầu kén rể đấy."
    },
    {
      "id": "trans_42",
      "start": 72.2,
      "end": 73.06,
      "text": "Đi muộn là không kịp đâu."
    },
    {
      "id": "trans_43",
      "start": 73.06,
      "end": 73.58,
      "text": "Kén rể?"
    },
    {
      "id": "trans_44",
      "start": 74.02,
      "end": 74.34,
      "text": "Đi!"
    },
    {
      "id": "trans_45",
      "start": 74.88,
      "end": 75.34,
      "text": "Đi xem."
    },
    {
      "id": "trans_46",
      "start": 75.34,
      "end": 77.28,
      "text": "Tần Thị Xung đã cướp cầu của ta,"
    },
    {
      "id": "trans_47",
      "start": 77.28,
      "end": 79.1,
      "text": "khiến ta phải chịu khổ sau khi trốn hôn."
    },
    {
      "id": "trans_48",
      "start": 79.86,
      "end": 80.46,
      "text": "Đúng lúc."
    },
    {
      "id": "trans_49",
      "start": 80.46,
      "end": 81.82,
      "text": "Ta cũng muốn cho ngươi nếm thử"
    },
    {
      "id": "trans_50",
      "start": 81.82,
      "end": 83.34,
      "text": "cảm giác bị người thân ruồng bỏ."
    },
    {
      "id": "trans_51",
      "start": 85.199,
      "end": 85.8,
      "text": "Đi đi"
    },
    {
      "id": "trans_52",
      "start": 85.8,
      "end": 86.82,
      "text": "Cứ làm theo lời ta nói"
    },
    {
      "id": "trans_53",
      "start": 86.82,
      "end": 87.18,
      "text": "Rõ"
    },
    {
      "id": "trans_54",
      "start": 87.18,
      "end": 87.66,
      "text": "Nhị tiểu thư"
    },
    {
      "id": "trans_55",
      "start": 87.66,
      "end": 88.74,
      "text": "Họ chỉ muốn"
    },
    {
      "id": "trans_56",
      "start": 88.74,
      "end": 90.04,
      "text": "Thẩm gia chúng ta"
    },
    {
      "id": "trans_57",
      "start": 90.04,
      "end": 91.54,
      "text": "Leo lên được Mộ Dung phủ cao quý"
    },
    {
      "id": "trans_58",
      "start": 91.54,
      "end": 93.24,
      "text": "Vân Thanh lát nữa chọn phu quân"
    },
    {
      "id": "trans_59",
      "start": 93.24,
      "end": 94.86,
      "text": "Không thể kém cỏi được"
    },
    {
      "id": "trans_60",
      "start": 94.86,
      "end": 95.32,
      "text": "Mẹ"
    },
    {
      "id": "trans_61",
      "start": 95.86,
      "end": 96.84,
      "text": "Người nói gì vậy"
    },
    {
      "id": "trans_62",
      "start": 96.84,
      "end": 98.38,
      "text": "Tỷ tỷ vốn dĩ vận khí tốt"
    },
    {
      "id": "trans_63",
      "start": 98.38,
      "end": 99.68,
      "text": "Sao lại làm mất mặt cha được"
    },
    {
      "id": "trans_64",
      "start": 100.24,
      "end": 101,
      "text": "Theo con thấy"
    },
    {
      "id": "trans_65",
      "start": 101,
      "end": 102.14,
      "text": "Tỷ ấy lát nữa"
    },
    {
      "id": "trans_66",
      "start": 102.14,
      "end": 103.86,
      "text": "nhất định sẽ chọn được một phu quân tốt nhất"
    },
    {
      "id": "trans_67",
      "start": 103.86,
      "end": 104.34,
      "text": "Vân Thanh"
    },
    {
      "id": "trans_68",
      "start": 104.86,
      "end": 106.02,
      "text": "Bây giờ hôn sự của em gái con"
    },
    {
      "id": "trans_69",
      "start": 106.02,
      "end": 107.06,
      "text": "coi như đã có kết quả"
    },
    {
      "id": "trans_70",
      "start": 107.06,
      "end": 108.34,
      "text": "Bây giờ có một người có quyền thế"
    },
    {
      "id": "trans_71",
      "start": 108.34,
      "end": 109.74,
      "text": "thì con hãy kiếm thêm một người có tài"
    },
    {
      "id": "trans_72",
      "start": 109.74,
      "end": 111.78,
      "text": "như vậy mới xứng với\nthân phận con gái của ta"
    },
    {
      "id": "trans_73",
      "start": 114.5,
      "end": 115.66,
      "text": "Tiểu thư, đến lượt cô"
    },
    {
      "id": "trans_74",
      "start": 115.66,
      "end": 117.36,
      "text": "Tất cả mưu tính chỉ vì tiền tài danh phận."
    },
    {
      "id": "trans_75",
      "start": 117.36,
      "end": 119.1,
      "text": "Chẳng qua là mây khói thoáng qua"
    },
    {
      "id": "trans_76",
      "start": 119.56,
      "end": 120.28,
      "text": "Kiếp này"
    },
    {
      "id": "trans_77",
      "start": 120.28,
      "end": 122.4,
      "text": "chỉ cầu có thể gặp được một người tri kỷ"
    },
    {
      "id": "trans_78",
      "start": 122.4,
      "end": 123.66,
      "text": "bình an sống hết một đời"
    },
    {
      "id": "trans_79",
      "start": 124.04,
      "end": 124.58,
      "text": "Chủ tử"
    },
    {
      "id": "trans_80",
      "start": 125.06,
      "end": 125.98,
      "text": "Thẩm tiểu thư"
    },
    {
      "id": "trans_81",
      "start": 125.98,
      "end": 127.96,
      "text": "Để ta"
    }
  ],
