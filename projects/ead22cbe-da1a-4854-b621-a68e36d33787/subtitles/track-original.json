[
  {
    "id": "3b2d51c0451e42b2822143af025a483d",
    "start": 0,
    "end": 1.44,
    "text": "末荣福审氏"
  },
  {
    "id": "11d18c072bed4ea1aea348a305270ac3",
    "start": 1.44,
    "end": 2.9,
    "text": "书顺姓程"
  },
  {
    "id": "7b50414bad9c4c2daab65494c2d9e7a2",
    "start": 2.9,
    "end": 4.18,
    "text": "请点柔顺"
  },
  {
    "id": "33198f065b5748b3965548d0d9b06c12",
    "start": 4.18,
    "end": 6.74,
    "text": "及措风为一评告命夫人"
  },
  {
    "id": "51f79abb13ec45629f9bd9cba98305b7",
    "start": 6.74,
    "end": 8.36,
    "text": "臣女扣谢龙恩"
  },
  {
    "id": "bafd4d29c4ca43fea410c8113c6bc734",
    "start": 9.120000000000001,
    "end": 9.96,
    "text": "末荣夫人"
  },
  {
    "id": "77c03174e6154629a1b5b5c65b0fb982",
    "start": 9.96,
    "end": 11.16,
    "text": "接指吧"
  },
  {
    "id": "0d6c2b260a8a4bb69d78344ef9e2df8e",
    "start": 19.400000000000002,
    "end": 20.26,
    "text": "来人啦"
  },
  {
    "id": "33a48b306b134b17b326597776caa646",
    "start": 20.26,
    "end": 22.16,
    "text": "来人啦"
  },
  {
    "id": "5bd7729487ad416e9ee1e1b8d7c2ee99",
    "start": 22.16,
    "end": 23.4,
    "text": "来人啦"
  },
  {
    "id": "ff8261c10c1245bab3e3d0e3ded82090",
    "start": 31.4,
    "end": 32.06,
    "text": "妹妹"
  },
  {
    "id": "08a2e6029f6847ddb7217cc637828c33",
    "start": 33.78,
    "end": 34.22,
    "text": "为什么"
  },
  {
    "id": "0b87c670a43d49a4b27277430f3f9d15",
    "start": 34.22,
    "end": 35.7,
    "text": "别叫我妹妹"
  },
  {
    "id": "db67f536ab8b4fd9a67e55860177a385",
    "start": 35.7,
    "end": 36.64,
    "text": "你不配"
  },
  {
    "id": "c93e9fe1a5f4404cba0b7e7dfef7ec0e",
    "start": 37.239999999999995,
    "end": 37.68,
    "text": "我"
  },
  {
    "id": "f8cf4a532f9942b0999b2ea725a26894",
    "start": 39.879999999999995,
    "end": 41.16,
    "text": "都是审价女儿"
  },
  {
    "id": "2673a25171b44e54bc3d0dae1ec15b1d",
    "start": 41.16,
    "end": 42.82,
    "text": "这什么你怪的别忘了"
  },
  {
    "id": "1a1cca62548a45d183c38f52895be29d",
    "start": 42.82,
    "end": 43.92,
    "text": "可是三年前接到我"
  },
  {
    "id": "6695c4ca05c8449e83e97178ebbf348f",
    "start": 43.92,
    "end": 44.86,
    "text": "向求的人是不弱"
  },
  {
    "id": "77a117256a0249a4945ac7fbc9bf9a2d",
    "start": 44.86,
    "end": 45.52,
    "text": "就好了"
  },
  {
    "id": "7d7aa035c63a4987abe35c132dd66a3d",
    "start": 45.52,
    "end": 46.78,
    "text": "你太明的没有"
  },
  {
    "id": "685ca7adeffc42f984a8abbb71f60a94",
    "start": 47.36,
    "end": 48.72,
    "text": "其实都是假性"
  },
  {
    "id": "80e95ad11bf2493cac670abffe5f33a9",
    "start": 50.019999999999996,
    "end": 50.9,
    "text": "谁一起"
  },
  {
    "id": "e0ea43bb389a4d128fd9cded20f9cd52",
    "start": 50.9,
    "end": 52.38,
    "text": "你却死吧"
  },
  {
    "id": "23f602283a0b47f4a1ee05fd25360b08",
    "start": 61.4,
    "end": 63.08,
    "text": "如果再给我一次机会"
  },
  {
    "id": "19065458accb467ca7784dca8a93b20e",
    "start": 63.08,
    "end": 65,
    "text": "我宁愿不要这形容你"
  },
  {
    "id": "a4c73eaaaa4d4eac8ea36fe9e8ffe694",
    "start": 67.94,
    "end": 69.22,
    "text": "这都什么时候了"
  },
  {
    "id": "d0897a127efe44d58499272880419e4e",
    "start": 69.22,
    "end": 70.36,
    "text": "还在这儿睡大叫"
  },
  {
    "id": "152f1dbc6d854b7d989e838c49b124f0",
    "start": 70.36,
    "end": 70.82,
    "text": "你这"
  },
  {
    "id": "c85708748e3b46a8be4ccc878a04de05",
    "start": 70.82,
    "end": 71.68,
    "text": "老爷"
  },
  {
    "id": "e15d3c83085540a49f9a674953cce1cd",
    "start": 71.68,
    "end": 73.38,
    "text": "这王宫贵族家的公子"
  },
  {
    "id": "9b0a0dba5a854b9b86590fb55cf030c8",
    "start": 73.38,
    "end": 74.8,
    "text": "听说审价女儿选夫"
  },
  {
    "id": "69a0df5f6ac04c9cbec63aa73ea7e996",
    "start": 74.8,
    "end": 76.06,
    "text": "都要来抢秀求了"
  },
  {
    "id": "c40670b730c1456086e0b6c1d9f1f02b",
    "start": 76.06,
    "end": 77.6,
    "text": "你看这云气还在这儿睡觉"
  },
  {
    "id": "6c89f8f3faeb4517902b8d972fd0e545",
    "start": 77.6,
    "end": 79.1,
    "text": "哪有点大小姐的样子"
  },
  {
    "id": "2c268028a810482e9e01297633e7734d",
    "start": 79.1,
    "end": 80.02,
    "text": "我告诉你"
  },
  {
    "id": "41673271dc944e16847e4ecc65f40833",
    "start": 80.02,
    "end": 81.34,
    "text": "你和瞧而抛秀求"
  },
  {
    "id": "af4fa695df8e44c59e34f2bb9d8ec806",
    "start": 81.34,
    "end": 82.28,
    "text": "要给我看准了"
  },
  {
    "id": "b9c16ea5fbed4a318f3bba4e97f11fe4",
    "start": 82.28,
    "end": 83.28,
    "text": "谁价得好"
  },
  {
    "id": "1cb3d9f76b764591b3984476acb33045",
    "start": 83.28,
    "end": 84.62,
    "text": "谁就是审价工程"
  },
  {
    "id": "c9df76eac40b43a38e4fd7a7f388fae5",
    "start": 84.62,
    "end": 85.74,
    "text": "你们可别让我失望"
  },
  {
    "id": "c16ae4fa7593409ca087a2d2a9e4fa7b",
    "start": 88.82,
    "end": 90.98,
    "text": "我刚刚不是被牵"
  },
  {
    "id": "70ab61030a5d4dffa5691b5f9b583937",
    "start": 97.94,
    "end": 99.48,
    "text": "我这是重生"
  },
  {
    "id": "d14be74971b3472d809dd60dfc675ba3",
    "start": 99.48,
    "end": 100.82,
    "text": "回到了三年前"
  },
  {
    "id": "c8b0f3a810ce44c9aea9fcb8fca05ed2",
    "start": 100.82,
    "end": 102.64,
    "text": "抛秀求选夫那天"
  },
  {
    "id": "985ccbc0c6a140be933f4e96c847f360",
    "start": 104.52,
    "end": 106.72,
    "text": "小姐 该您抛秀求了"
  },
  {
    "id": "66ec54faa76f4be2afe9794a591fa40a",
    "start": 108.74,
    "end": 109.66,
    "text": "沈云桥"
  },
  {
    "id": "2284babc27df4798aea869f95eb3311f",
    "start": 110.8,
    "end": 111.58,
    "text": "姐姐"
  },
  {
    "id": "dad42ccf3e4c47c2a5d083a3c9c8596c",
    "start": 111.58,
    "end": 113.24,
    "text": "不能让我先躺"
  },
  {
    "id": "31428ba99200472f95b50ac6fb864521",
    "start": 113.24,
    "end": 114.6,
    "text": "前是沈云桥"
  },
  {
    "id": "90846c13e3ce43ee9a4d65401c8f3a77",
    "start": 114.6,
    "end": 115.8,
    "text": "她为了让我先抛秀求"
  },
  {
    "id": "796c7c3b6a8e4f24b09e5951ec277a76",
    "start": 115.8,
    "end": 117.02,
    "text": "可是百般推上"
  },
  {
    "id": "62529eb0f3754b8f909c6233c9400e11",
    "start": 117.94,
    "end": 118.76,
    "text": "如今子"
  },
  {
    "id": "685f3fbdf7cd4e29acaae2214592857c",
    "start": 119.46,
    "end": 121.8,
    "text": "看来沈云桥也出生了"
  },
  {
    "id": "4d0948fc46584121ae0f064b54f9cc61",
    "start": 121.8,
    "end": 122.28,
    "text": "好啊"
  },
  {
    "id": "bbe4e2b0af8d4d84a67185d308ed88a6",
    "start": 122.28,
    "end": 123.62,
    "text": "你先"
  },
  {
    "id": "4674d82df7804ca088f51fbe42826605",
    "start": 124.53999999999999,
    "end": 124.94,
    "text": "给我"
  },
  {
    "id": "1d8ec98dae9f4586a61fb815aa0b2ea2",
    "start": 125.88,
    "end": 126.28,
    "text": "给我"
  },
  {
    "id": "93c51026af914cc78fe909cf9c08499f",
    "start": 126.28,
    "end": 126.6,
    "text": "给我"
  },
  {
    "id": "6a13b876f8664d49ae2ada9b60644172",
    "start": 126.6,
    "end": 128.48,
    "text": "谁想起来"
  },
  {
    "id": "d5c5a759196748f69f1993b3f338ee32",
    "start": 128.48,
    "end": 129.16,
    "text": "谁想起来"
  },
  {
    "id": "59d1c421a16c493991c611de1b5f7d8a",
    "start": 129.16,
    "end": 129.44,
    "text": "给我"
  },
  {
    "id": "4d92bfa7a2cb43718c528b0b6cabb7d3",
    "start": 129.96,
    "end": 130.36,
    "text": "给我"
  },
  {
    "id": "31aac0275a7047189eac88c4c5925170",
    "start": 130.36,
    "end": 130.56,
    "text": "给我"
  },
  {
    "id": "00237cbdc6db48b3bd2ceb184d97d742",
    "start": 137.38,
    "end": 138.44,
    "text": "这一世"
  },
  {
    "id": "271fbb01fee648219ad1560bd2b01015",
    "start": 138.44,
    "end": 139.82,
    "text": "嫁给慕容安的人"
  },
  {
    "id": "957cb19aa1d849b1baac3850a7b1b7c8",
    "start": 139.82,
    "end": 140.68,
    "text": "只能是我"
  },
  {
    "id": "088b9de8c1f444909df28540dfc11503",
    "start": 147.70000000000002,
    "end": 148.02,
    "text": "慕容安"
  },
  {
    "id": "26b8aaba94c24d9f953111a6476bbbcc",
    "start": 148.02,
    "end": 148.6,
    "text": "老爷快看"
  },
  {
    "id": "c2eed69ea2864698842ec65bcc3304fb",
    "start": 148.6,
    "end": 149.48,
    "text": "接受求的"
  },
  {
    "id": "1fdd641b00654bff8167c5a4cf797e45",
    "start": 149.48,
    "end": 150.66,
    "text": "可是慕容伐二公府"
  },
  {
    "id": "249c3c8a87f44310804349c1b26cbc4d",
    "start": 150.66,
    "end": 151.36,
    "text": "是她"
  },
  {
    "id": "7bce7a64f4d34e8abfaf1771ead2ace7",
    "start": 151.70000000000002,
    "end": 153.3,
    "text": "是慕容伐二公子慕容安"
  },
  {
    "id": "5c7accc3ddc94b79a75e7176124a5ca8",
    "start": 153.3,
    "end": 155.08,
    "text": "慕容家可是皇氏眼心"
  },
  {
    "id": "44f077891f0646b59b514a764ee8783f",
    "start": 155.08,
    "end": 156.22,
    "text": "大公子慕容赫"
  },
  {
    "id": "2dde3ad45b314797b42135e3a64089c9",
    "start": 156.22,
    "end": 158.18,
    "text": "前几日高被任命为大姆斯少亲"
  },
  {
    "id": "0cabd6504c934ec4b704e98b92cf0102",
    "start": 158.54000000000002,
    "end": 159.36,
    "text": "若是沈家"
  },
  {
    "id": "eabd9a9cea204efca6b1447c566320f0",
    "start": 159.36,
    "end": 160.56,
    "text": "能跟慕容府结亲"
  },
  {
    "id": "55b9a107874248d199becf24891798e0",
    "start": 160.56,
    "end": 162.18,
    "text": "我们快点成了皇亲国气"
  },
  {
    "id": "d0f8f74862a84aaf981aa8a536cbe389",
    "start": 162.56,
    "end": 163.42,
    "text": "慕容安"
  },
  {
    "id": "9c936b32a8cb40aeae97edff08dcb63c",
    "start": 164.28,
    "end": 164.92,
    "text": "这一世"
  },
  {
    "id": "aebe89f4e06d42a09df368b2079c1827",
    "start": 164.92,
    "end": 166.44,
    "text": "我终于改变命运了"
  },
  {
    "id": "6f6b4d9427a04878978314340014de2b",
    "start": 166.88,
    "end": 169.08,
    "text": "三年后慕容安家关进群"
  },
  {
    "id": "cbe31533cf044b06bb882839feb2310c",
    "start": 169.08,
    "end": 169.94,
    "text": "而我"
  },
  {
    "id": "8a6d37a1953b474087e99b7d8af20aeb",
    "start": 169.94,
    "end": 171.94,
    "text": "会成为尊贵的告命夫人"
  },
  {
    "id": "4020b9dab265415896ae135e3fc02432",
    "start": 171.94,
    "end": 173.48,
    "text": "沈云桥啊沈云桥"
  },
  {
    "id": "361c15533c324e8d9c64d8a47006a316",
    "start": 173.48,
    "end": 174.78,
    "text": "你废尽心死"
  },
  {
    "id": "2318ea0063904b129fd95e059a9b8fb9",
    "start": 174.78,
    "end": 176.7,
    "text": "却不知是一脚踏进了狼狗"
  }
]