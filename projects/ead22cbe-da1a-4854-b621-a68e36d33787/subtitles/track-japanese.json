[
  {
    "id": "trans_0",
    "start": 0,
    "end": 1.44,
    "text": "末栄福審氏"
  },
  {
    "id": "trans_1",
    "start": 1.44,
    "end": 2.9,
    "text": "書順、姓は程"
  },
  {
    "id": "trans_2",
    "start": 2.9,
    "end": 4.18,
    "text": "請う、柔順に"
  },
  {
    "id": "trans_3",
    "start": 4.18,
    "end": 6.74,
    "text": "及び措風を以て一評告命夫人と為す"
  },
  {
    "id": "trans_4",
    "start": 6.74,
    "end": 8.36,
    "text": "臣女、竜恩を叩謝す"
  },
  {
    "id": "trans_5",
    "start": 9.12,
    "end": 9.96,
    "text": "末栄夫人"
  },
  {
    "id": "trans_6",
    "start": 9.96,
    "end": 11.16,
    "text": "指を受け取れ"
  },
  {
    "id": "trans_7",
    "start": 19.4,
    "end": 20.26,
    "text": "誰か来い！"
  },
  {
    "id": "trans_8",
    "start": 20.26,
    "end": 22.16,
    "text": "誰か来い！"
  },
  {
    "id": "trans_9",
    "start": 22.16,
    "end": 23.4,
    "text": "誰か来い！"
  },
  {
    "id": "trans_10",
    "start": 31.4,
    "end": 32.06,
    "text": "妹よ"
  },
  {
    "id": "trans_11",
    "start": 33.78,
    "end": 34.22,
    "text": "なぜだ"
  },
  {
    "id": "trans_12",
    "start": 34.22,
    "end": 35.7,
    "text": "妹と呼ばないで"
  },
  {
    "id": "trans_13",
    "start": 35.7,
    "end": 36.64,
    "text": "お前に資格はない"
  },
  {
    "id": "trans_14",
    "start": 37.239,
    "end": 37.68,
    "text": "私は"
  },
  {
    "id": "trans_15",
    "start": 39.879,
    "end": 41.16,
    "text": "どちらも審价の娘だ"
  },
  {
    "id": "trans_16",
    "start": 41.16,
    "end": 42.82,
    "text": "これは何だ、お前の恨みを忘れるな"
  },
  {
    "id": "trans_17",
    "start": 42.82,
    "end": 43.92,
    "text": "しかし三年前、私を迎えに来たのは"
  },
  {
    "id": "trans_18",
    "start": 43.92,
    "end": 44.86,
    "text": "求婚してきた者は弱くはなかった"
  },
  {
    "id": "trans_19",
    "start": 44.86,
    "end": 45.52,
    "text": "それで良かったのに"
  },
  {
    "id": "trans_20",
    "start": 45.52,
    "end": 46.78,
    "text": "お前は明らかに何も持っていない"
  },
  {
    "id": "trans_21",
    "start": 47.36,
    "end": 48.72,
    "text": "実はすべて偽りだ"
  },
  {
    "id": "trans_22",
    "start": 50.019,
    "end": 50.9,
    "text": "誰が一緒に"
  },
  {
    "id": "trans_23",
    "start": 50.9,
    "end": 52.38,
    "text": "お前は死ね"
  },
  {
    "id": "trans_24",
    "start": 61.4,
    "end": 63.08,
    "text": "もう一度チャンスがあるなら"
  },
  {
    "id": "trans_25",
    "start": 63.08,
    "end": 65,
    "text": "お前をこんな風に形容したくない"
  },
  {
    "id": "trans_26",
    "start": 67.94,
    "end": 69.22,
    "text": "今はどんな時だと思っているんだ"
  },
  {
    "id": "trans_27",
    "start": 69.22,
    "end": 70.36,
    "text": "まだここで大声で寝ているのか"
  },
  {
    "id": "trans_28",
    "start": 70.36,
    "end": 70.82,
    "text": "お前は"
  },
  {
    "id": "trans_29",
    "start": 70.82,
    "end": 71.68,
    "text": "旦那様"
  },
  {
    "id": "trans_30",
    "start": 71.68,
    "end": 73.38,
    "text": "この王宮貴族の若様たちが"
  },
  {
    "id": "trans_31",
    "start": 73.38,
    "end": 74.8,
    "text": "審价家の娘の婿選びと聞いて"
  },
  {
    "id": "trans_32",
    "start": 74.8,
    "end": 76.06,
    "text": "皆、求婚に殺到している"
  },
  {
    "id": "trans_33",
    "start": 76.06,
    "end": 77.6,
    "text": "この雲気め、まだここで寝ている"
  },
  {
    "id": "trans_34",
    "start": 77.6,
    "end": 79.1,
    "text": "どこにお嬢様らしさがあるんだ"
  },
  {
    "id": "trans_35",
    "start": 79.1,
    "end": 80.02,
    "text": "言っておくが"
  },
  {
    "id": "trans_36",
    "start": 80.02,
    "end": 81.34,
    "text": "お前はあの求婚者たちを"
  },
  {
    "id": "trans_37",
    "start": 81.34,
    "end": 82.28,
    "text": "しっかり見極めろ"
  },
  {
    "id": "trans_38",
    "start": 82.28,
    "end": 83.28,
    "text": "誰が良い家柄か"
  },
  {
    "id": "trans_39",
    "start": 83.28,
    "end": 84.62,
    "text": "誰が審价家の跡取りになるか"
  },
  {
    "id": "trans_40",
    "start": 84.62,
    "end": 85.74,
    "text": "お前たち、私をがっかりさせるなよ"
  },
  {
    "id": "trans_41",
    "start": 88.82,
    "end": 90.98,
    "text": "さっき引っ張られたんじゃない"
  },
  {
    "id": "trans_42",
    "start": 97.94,
    "end": 99.48,
    "text": "私は転生した"
  },
  {
    "id": "trans_43",
    "start": 99.48,
    "end": 100.82,
    "text": "三年前に戻ってきた"
  },
  {
    "id": "trans_44",
    "start": 100.82,
    "end": 102.64,
    "text": "抛秀求で婿選びをしたあの日"
  },
  {
    "id": "trans_45",
    "start": 104.52,
    "end": 106.72,
    "text": "お嬢様、抛秀求のお時間です"
  },
  {
    "id": "trans_46",
    "start": 108.74,
    "end": 109.66,
    "text": "沈云橋"
  },
  {
    "id": "trans_47",
    "start": 110.8,
    "end": 111.58,
    "text": "お姉さま"
  },
  {
    "id": "trans_48",
    "start": 111.58,
    "end": 113.24,
    "text": "私に先にやらせるわけにはいかない"
  },
  {
    "id": "trans_49",
    "start": 113.24,
    "end": 114.6,
    "text": "前は沈云橋だった"
  },
  {
    "id": "trans_50",
    "start": 114.6,
    "end": 115.8,
    "text": "彼女は私に先に抛秀求をさせるために"
  },
  {
    "id": "trans_51",
    "start": 115.8,
    "end": 117.02,
    "text": "あれこれと推してきた"
  },
  {
    "id": "trans_52",
    "start": 117.94,
    "end": 118.76,
    "text": "今度は"
  },
  {
    "id": "trans_53",
    "start": 119.46,
    "end": 121.8,
    "text": "どうやら沈云橋も生まれたようだ"
  },
  {
    "id": "trans_54",
    "start": 121.8,
    "end": 122.28,
    "text": "よし"
  },
  {
    "id": "trans_55",
    "start": 122.28,
    "end": 123.62,
    "text": "あなたが先に"
  },
  {
    "id": "trans_56",
    "start": 124.539,
    "end": 124.94,
    "text": "よこせ"
  },
  {
    "id": "trans_57",
    "start": 125.88,
    "end": 126.28,
    "text": "よこせ"
  },
  {
    "id": "trans_58",
    "start": 126.28,
    "end": 126.6,
    "text": "よこせ"
  },
  {
    "id": "trans_59",
    "start": 126.6,
    "end": 128.479,
    "text": "誰が思い出そうと"
  },
  {
    "id": "trans_60",
    "start": 128.479,
    "end": 129.16,
    "text": "誰が思い出そうと"
  },
  {
    "id": "trans_61",
    "start": 129.16,
    "end": 129.44,
    "text": "よこせ"
  },
  {
    "id": "trans_62",
    "start": 129.96,
    "end": 130.36,
    "text": "よこせ"
  },
  {
    "id": "trans_63",
    "start": 130.36,
    "end": 130.56,
    "text": "よこせ"
  },
  {
    "id": "trans_64",
    "start": 137.38,
    "end": 138.44,
    "text": "この世では"
  },
  {
    "id": "trans_65",
    "start": 138.44,
    "end": 139.82,
    "text": "慕容安に嫁ぐ者"
  },
  {
    "id": "trans_66",
    "start": 139.82,
    "end": 140.68,
    "text": "私だけだ"
  },
  {
    "id": "trans_67",
    "start": 147.7,
    "end": 148.02,
    "text": "慕容安"
  },
  {
    "id": "trans_68",
    "start": 148.02,
    "end": 148.6,
    "text": "旦那様、ご覧ください"
  },
  {
    "id": "trans_69",
    "start": 148.6,
    "end": 149.48,
    "text": "求婚を受け入れるのは"
  },
  {
    "id": "trans_70",
    "start": 149.48,
    "end": 150.66,
    "text": "しかし、慕容伐の次男の屋敷です"
  },
  {
    "id": "trans_71",
    "start": 150.66,
    "end": 151.36,
    "text": "彼女だ"
  },
  {
    "id": "trans_72",
    "start": 151.7,
    "end": 153.3,
    "text": "慕容伐の次男、慕容安です"
  },
  {
    "id": "trans_73",
    "start": 153.3,
    "end": 155.08,
    "text": "慕容家は皇室の目玉です"
  },
  {
    "id": "trans_74",
    "start": 155.08,
    "end": 156.22,
    "text": "長男の慕容赫"
  },
  {
    "id": "trans_75",
    "start": 156.22,
    "end": 158.18,
    "text": "先日、大姆斯少親に任命されました"
  },
  {
    "id": "trans_76",
    "start": 158.54,
    "end": 159.36,
    "text": "もし沈家が"
  },
  {
    "id": "trans_77",
    "start": 159.36,
    "end": 160.56,
    "text": "慕容家と縁組できれば"
  },
  {
    "id": "trans_78",
    "start": 160.56,
    "end": 162.18,
    "text": "我々はすぐに皇族の親戚になれます"
  },
  {
    "id": "trans_79",
    "start": 162.56,
    "end": 163.42,
    "text": "慕容安"
  },
  {
    "id": "trans_80",
    "start": 164.28,
    "end": 164.92,
    "text": "この世では"
  },
  {
    "id": "trans_81",
    "start": 164.92,
    "end": 166.44,
    "text": "ついに運命を変えた"
  },
  {
    "id": "trans_82",
    "start": 166.88,
    "end": 169.08,
    "text": "三年後、慕容安の家は没落する"
  },
  {
    "id": "trans_83",
    "start": 169.08,
    "end": 169.94,
    "text": "そして私は"
  },
  {
    "id": "trans_84",
    "start": 169.94,
    "end": 171.94,
    "text": "尊い告命夫人になる"
  },
  {
    "id": "trans_85",
    "start": 171.94,
    "end": 173.48,
    "text": "沈雲橋よ、沈雲橋"
  },
  {
    "id": "trans_86",
    "start": 173.48,
    "end": 174.78,
    "text": "お前は心を尽くしても"
  },
  {
    "id": "trans_87",
    "start": 174.78,
    "end": 176.7,
    "text": "狼の巣に足を踏み入れたことにも気づかない"
  }
]