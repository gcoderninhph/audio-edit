[
  {
    "id": "trans_0",
    "start": 0,
    "end": 1.44,
    "text": "말말 복심씨"
  },
  {
    "id": "trans_1",
    "start": 1.44,
    "end": 2.9,
    "text": "서순은 정씨 성을 가졌다"
  },
  {
    "id": "trans_2",
    "start": 2.9,
    "end": 4.18,
    "text": "유순을 청하다"
  },
  {
    "id": "trans_3",
    "start": 4.18,
    "end": 6.74,
    "text": "급조풍이 일평고명부인이 되다"
  },
  {
    "id": "trans_4",
    "start": 6.74,
    "end": 8.36,
    "text": "신녀가 용은에 감사드리며 절하다"
  },
  {
    "id": "trans_5",
    "start": 9.12,
    "end": 9.96,
    "text": "말말 부인"
  },
  {
    "id": "trans_6",
    "start": 9.96,
    "end": 11.16,
    "text": "명령을 받들어라"
  },
  {
    "id": "trans_7",
    "start": 19.4,
    "end": 20.26,
    "text": "사람을 불러라"
  },
  {
    "id": "trans_8",
    "start": 20.26,
    "end": 22.16,
    "text": "사람을 불러라"
  },
  {
    "id": "trans_9",
    "start": 22.16,
    "end": 23.4,
    "text": "사람을 불러라"
  },
  {
    "id": "trans_10",
    "start": 31.4,
    "end": 32.06,
    "text": "여동생"
  },
  {
    "id": "trans_11",
    "start": 33.78,
    "end": 34.22,
    "text": "왜"
  },
  {
    "id": "trans_12",
    "start": 34.22,
    "end": 35.7,
    "text": "나를 여동생이라 부르지 마"
  },
  {
    "id": "trans_13",
    "start": 35.7,
    "end": 36.64,
    "text": "네 자격이 없다"
  },
  {
    "id": "trans_14",
    "start": 37.239,
    "end": 37.68,
    "text": "나"
  },
  {
    "id": "trans_15",
    "start": 39.879,
    "end": 41.16,
    "text": "모두 심가의 딸이다"
  },
  {
    "id": "trans_16",
    "start": 41.16,
    "end": 42.82,
    "text": "이게 뭐냐, 네가 원망하는 것을 잊지 마라"
  },
  {
    "id": "trans_17",
    "start": 42.82,
    "end": 43.92,
    "text": "하지만 3년 전에 나를 맞이한"
  },
  {
    "id": "trans_18",
    "start": 43.92,
    "end": 44.86,
    "text": "구하러 온 사람은 약하지 않았다"
  },
  {
    "id": "trans_19",
    "start": 44.86,
    "end": 45.52,
    "text": "됐다"
  },
  {
    "id": "trans_20",
    "start": 45.52,
    "end": 46.78,
    "text": "너는 너무 똑똑하지 않다"
  },
  {
    "id": "trans_21",
    "start": 47.36,
    "end": 48.72,
    "text": "사실 모두 가짜다"
  },
  {
    "id": "trans_22",
    "start": 50.019,
    "end": 50.9,
    "text": "누가 함께"
  },
  {
    "id": "trans_23",
    "start": 50.9,
    "end": 52.38,
    "text": "너는 죽어라"
  },
  {
    "id": "trans_24",
    "start": 61.4,
    "end": 63.08,
    "text": "만약 다시 한 번 기회가 주어진다면"
  },
  {
    "id": "trans_25",
    "start": 63.08,
    "end": 65,
    "text": "차라리 이렇게 너를 형용하지 않겠어"
  },
  {
    "id": "trans_26",
    "start": 67.94,
    "end": 69.22,
    "text": "이게 다 몇 시인데"
  },
  {
    "id": "trans_27",
    "start": 69.22,
    "end": 70.36,
    "text": "아직도 여기서 코를 골며 자고 있어?"
  },
  {
    "id": "trans_28",
    "start": 70.36,
    "end": 70.82,
    "text": "이런"
  },
  {
    "id": "trans_29",
    "start": 70.82,
    "end": 71.68,
    "text": "나리"
  },
  {
    "id": "trans_30",
    "start": 71.68,
    "end": 73.38,
    "text": "이 왕궁 귀족 집안의 도련님들이"
  },
  {
    "id": "trans_31",
    "start": 73.38,
    "end": 74.8,
    "text": "심가 따님의 혼처를 고른다는 소문을 듣고"
  },
  {
    "id": "trans_32",
    "start": 74.8,
    "end": 76.06,
    "text": "모두 구혼하러 몰려들고 있어요"
  },
  {
    "id": "trans_33",
    "start": 76.06,
    "end": 77.6,
    "text": "이걸 봐, 아직도 여기서 자고 있네"
  },
  {
    "id": "trans_34",
    "start": 77.6,
    "end": 79.1,
    "text": "어디 아가씨다운 구석이 있나?"
  },
  {
    "id": "trans_35",
    "start": 79.1,
    "end": 80.02,
    "text": "내가 말하는데"
  },
  {
    "id": "trans_36",
    "start": 80.02,
    "end": 81.34,
    "text": "너와 교이포수구는"
  },
  {
    "id": "trans_37",
    "start": 81.34,
    "end": 82.28,
    "text": "잘 살펴봐야 해"
  },
  {
    "id": "trans_38",
    "start": 82.28,
    "end": 83.28,
    "text": "누가 더 나은지"
  },
  {
    "id": "trans_39",
    "start": 83.28,
    "end": 84.62,
    "text": "그 사람이 심가의 사위가 될 거야"
  },
  {
    "id": "trans_40",
    "start": 84.62,
    "end": 85.74,
    "text": "너희들이 나를 실망시키지 마라"
  },
  {
    "id": "trans_41",
    "start": 88.82,
    "end": 90.98,
    "text": "아까 내가 끌려간 게 아니야"
  },
  {
    "id": "trans_42",
    "start": 97.94,
    "end": 99.48,
    "text": "나는 환생했구나"
  },
  {
    "id": "trans_43",
    "start": 99.48,
    "end": 100.82,
    "text": "3년 전으로 돌아왔어"
  },
  {
    "id": "trans_44",
    "start": 100.82,
    "end": 102.64,
    "text": "구혼 행사가 열리던 그날"
  },
  {
    "id": "trans_45",
    "start": 104.52,
    "end": 106.72,
    "text": "아가씨, 이제 구혼을 시작하셔야 합니다"
  },
  {
    "id": "trans_46",
    "start": 108.74,
    "end": 109.66,
    "text": "심운교"
  },
  {
    "id": "trans_47",
    "start": 110.8,
    "end": 111.58,
    "text": "언니"
  },
  {
    "id": "trans_48",
    "start": 111.58,
    "end": 113.24,
    "text": "나를 먼저 쉬게 할 수는 없어"
  },
  {
    "id": "trans_49",
    "start": 113.24,
    "end": 114.6,
    "text": "앞에는 심운교가 있었지"
  },
  {
    "id": "trans_50",
    "start": 114.6,
    "end": 115.8,
    "text": "그녀는 내가 먼저 구혼하게 하려고"
  },
  {
    "id": "trans_51",
    "start": 115.8,
    "end": 117.02,
    "text": "갖은 방법으로 밀어붙였어"
  },
  {
    "id": "trans_52",
    "start": 117.94,
    "end": 118.76,
    "text": "지금은"
  },
  {
    "id": "trans_53",
    "start": 119.46,
    "end": 121.8,
    "text": "보아하니 심운교도 태어났군"
  },
  {
    "id": "trans_54",
    "start": 121.8,
    "end": 122.28,
    "text": "좋아"
  },
  {
    "id": "trans_55",
    "start": 122.28,
    "end": 123.62,
    "text": "네가 먼저 해"
  },
  {
    "id": "trans_56",
    "start": 124.539,
    "end": 124.94,
    "text": "내게 줘"
  },
  {
    "id": "trans_57",
    "start": 125.88,
    "end": 126.28,
    "text": "내게 줘"
  },
  {
    "id": "trans_58",
    "start": 126.28,
    "end": 126.6,
    "text": "내게 줘"
  },
  {
    "id": "trans_59",
    "start": 126.6,
    "end": 128.479,
    "text": "누가 생각나든"
  },
  {
    "id": "trans_60",
    "start": 128.479,
    "end": 129.16,
    "text": "누가 생각나든"
  },
  {
    "id": "trans_61",
    "start": 129.16,
    "end": 129.44,
    "text": "내게 줘"
  },
  {
    "id": "trans_62",
    "start": 129.96,
    "end": 130.36,
    "text": "내게 줘"
  },
  {
    "id": "trans_63",
    "start": 130.36,
    "end": 130.56,
    "text": "내게 줘"
  },
  {
    "id": "trans_64",
    "start": 137.38,
    "end": 138.44,
    "text": "이번 생에서는"
  },
  {
    "id": "trans_65",
    "start": 138.44,
    "end": 139.82,
    "text": "모용안과 결혼하는 사람은"
  },
  {
    "id": "trans_66",
    "start": 139.82,
    "end": 140.68,
    "text": "오직 나여야 해"
  },
  {
    "id": "trans_67",
    "start": 147.7,
    "end": 148.02,
    "text": "모용안"
  },
  {
    "id": "trans_68",
    "start": 148.02,
    "end": 148.6,
    "text": "나리, 빨리 보세요"
  },
  {
    "id": "trans_69",
    "start": 148.6,
    "end": 149.48,
    "text": "구혼을 받아들여"
  },
  {
    "id": "trans_70",
    "start": 149.48,
    "end": 150.66,
    "text": "그런데 모용벌 이공부는"
  },
  {
    "id": "trans_71",
    "start": 150.66,
    "end": 151.36,
    "text": "그녀다"
  },
  {
    "id": "trans_72",
    "start": 151.7,
    "end": 153.3,
    "text": "모용벌의 둘째 아들 모용안이야"
  },
  {
    "id": "trans_73",
    "start": 153.3,
    "end": 155.08,
    "text": "모용가는 황실의 눈과 심장과 같아"
  },
  {
    "id": "trans_74",
    "start": 155.08,
    "end": 156.22,
    "text": "큰아들 모용혁은"
  },
  {
    "id": "trans_75",
    "start": 156.22,
    "end": 158.18,
    "text": "며칠 전 대사소친으로 임명되었소"
  },
  {
    "id": "trans_76",
    "start": 158.54,
    "end": 159.36,
    "text": "만약 심가가"
  },
  {
    "id": "trans_77",
    "start": 159.36,
    "end": 160.56,
    "text": "모용부와 혼인을 맺는다면"
  },
  {
    "id": "trans_78",
    "start": 160.56,
    "end": 162.18,
    "text": "우리는 곧 황친국척이 될 거야"
  },
  {
    "id": "trans_79",
    "start": 162.56,
    "end": 163.42,
    "text": "모용안"
  },
  {
    "id": "trans_80",
    "start": 164.28,
    "end": 164.92,
    "text": "이번 생에서는"
  },
  {
    "id": "trans_81",
    "start": 164.92,
    "end": 166.44,
    "text": "드디어 운명을 바꿨다"
  },
  {
    "id": "trans_82",
    "start": 166.88,
    "end": 169.08,
    "text": "3년 후 모용안은 가문이 몰락하고"
  },
  {
    "id": "trans_83",
    "start": 169.08,
    "end": 169.94,
    "text": "그리고 나는"
  },
  {
    "id": "trans_84",
    "start": 169.94,
    "end": 171.94,
    "text": "존귀한 고명부인이 될 거야"
  },
  {
    "id": "trans_85",
    "start": 171.94,
    "end": 173.48,
    "text": "심운교야 심운교"
  },
  {
    "id": "trans_86",
    "start": 173.48,
    "end": 174.78,
    "text": "네가 애를 썼지만"
  },
  {
    "id": "trans_87",
    "start": 174.78,
    "end": 176.7,
    "text": "한 발을 늑대 굴에 들여놓은 줄도 모르는구나"
  }
]