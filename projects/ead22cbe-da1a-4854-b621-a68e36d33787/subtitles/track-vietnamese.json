[
  {
    "id": "trans_0",
    "start": 0,
    "end": 1.44,
    "text": "Mạt Vinh Phúc Thẩm Thị"
  },
  {
    "id": "trans_1",
    "start": 1.44,
    "end": 2.9,
    "text": "Thư Thuận họ Trình"
  },
  {
    "id": "trans_2",
    "start": 2.9,
    "end": 4.18,
    "text": "Xin điểm nhu thuận"
  },
  {
    "id": "trans_3",
    "start": 4.18,
    "end": 6.74,
    "text": "Hoàng đế phong vi nhất bình cáo mệnh phu nhân"
  },
  {
    "id": "trans_4",
    "start": 6.74,
    "end": 8.36,
    "text": "Thần nữ khấu tạ long ân"
  },
  {
    "id": "trans_5",
    "start": 9.12,
    "end": 9.96,
    "text": "Mạt Vinh phu nhân"
  },
  {
    "id": "trans_6",
    "start": 9.96,
    "end": 11.16,
    "text": "Nhận chỉ đi"
  },
  {
    "id": "trans_7",
    "start": 19.4,
    "end": 20.26,
    "text": "Người đâu"
  },
  {
    "id": "trans_8",
    "start": 20.26,
    "end": 22.16,
    "text": "Người đâu"
  },
  {
    "id": "trans_9",
    "start": 22.16,
    "end": 23.4,
    "text": "Người đâu"
  },
  {
    "id": "trans_10",
    "start": 31.4,
    "end": 32.06,
    "text": "Muội muội"
  },
  {
    "id": "trans_11",
    "start": 33.78,
    "end": 34.22,
    "text": "Vì sao"
  },
  {
    "id": "trans_12",
    "start": 34.22,
    "end": 35.7,
    "text": "Đừng gọi ta là muội muội"
  },
  {
    "id": "trans_13",
    "start": 35.7,
    "end": 36.64,
    "text": "Ngươi không xứng"
  },
  {
    "id": "trans_14",
    "start": 37.239,
    "end": 37.68,
    "text": "Ta"
  },
  {
    "id": "trans_15",
    "start": 39.879,
    "end": 41.16,
    "text": "Đều là con gái của Thẩm giá"
  },
  {
    "id": "trans_16",
    "start": 41.16,
    "end": 42.82,
    "text": "Cái gì, ngươi trách, đừng quên"
  },
  {
    "id": "trans_17",
    "start": 42.82,
    "end": 43.92,
    "text": "Nhưng ba năm trước tiếp được ta"
  },
  {
    "id": "trans_18",
    "start": 43.92,
    "end": 44.86,
    "text": "Hướng cầu người là bất nhược"
  },
  {
    "id": "trans_19",
    "start": 44.86,
    "end": 45.52,
    "text": "Là tốt rồi"
  },
  {
    "id": "trans_20",
    "start": 45.52,
    "end": 46.78,
    "text": "Ngươi quá rõ ràng không có"
  },
  {
    "id": "trans_21",
    "start": 47.36,
    "end": 48.72,
    "text": "Kỳ thực đều là giả tính"
  },
  {
    "id": "trans_22",
    "start": 50.019,
    "end": 50.9,
    "text": "Ai cùng nhau"
  },
  {
    "id": "trans_23",
    "start": 50.9,
    "end": 52.38,
    "text": "Ngươi thì chết đi"
  },
  {
    "id": "trans_24",
    "start": 61.4,
    "end": 63.08,
    "text": "Nếu cho tôi thêm một cơ hội nữa"
  },
  {
    "id": "trans_25",
    "start": 63.08,
    "end": 65,
    "text": "Tôi thà không dùng từ này để miêu tả cô"
  },
  {
    "id": "trans_26",
    "start": 67.94,
    "end": 69.22,
    "text": "Đã đến lúc nào rồi"
  },
  {
    "id": "trans_27",
    "start": 69.22,
    "end": 70.36,
    "text": "Còn ở đây ngủ gật"
  },
  {
    "id": "trans_28",
    "start": 70.36,
    "end": 70.82,
    "text": "Cô này"
  },
  {
    "id": "trans_29",
    "start": 70.82,
    "end": 71.68,
    "text": "Lão gia"
  },
  {
    "id": "trans_30",
    "start": 71.68,
    "end": 73.38,
    "text": "Các công tử nhà quý tộc hoàng gia"
  },
  {
    "id": "trans_31",
    "start": 73.38,
    "end": 74.8,
    "text": "Nghe nói thẩm giá con gái chọn chồng"
  },
  {
    "id": "trans_32",
    "start": 74.8,
    "end": 76.06,
    "text": "Đều đến tranh giành cầu hôn rồi"
  },
  {
    "id": "trans_33",
    "start": 76.06,
    "end": 77.6,
    "text": "Cô xem, mây khí còn ở đây ngủ"
  },
  {
    "id": "trans_34",
    "start": 77.6,
    "end": 79.1,
    "text": "Có chút nào ra dáng tiểu thư đâu"
  },
  {
    "id": "trans_35",
    "start": 79.1,
    "end": 80.02,
    "text": "Tôi nói cho cô biết"
  },
  {
    "id": "trans_36",
    "start": 80.02,
    "end": 81.34,
    "text": "Cô và người kia ném cầu kết duyên"
  },
  {
    "id": "trans_37",
    "start": 81.34,
    "end": 82.28,
    "text": "Phải nhìn cho chuẩn vào"
  },
  {
    "id": "trans_38",
    "start": 82.28,
    "end": 83.28,
    "text": "Ai giá tốt"
  },
  {
    "id": "trans_39",
    "start": 83.28,
    "end": 84.62,
    "text": "Người đó chính là thẩm giá công trình"
  },
  {
    "id": "trans_40",
    "start": 84.62,
    "end": 85.74,
    "text": "Các cô đừng để tôi thất vọng"
  },
  {
    "id": "trans_41",
    "start": 88.82,
    "end": 90.98,
    "text": "Tôi vừa rồi không phải bị kéo"
  },
  {
    "id": "trans_42",
    "start": 97.94,
    "end": 99.48,
    "text": "Ta đây là tái sinh"
  },
  {
    "id": "trans_43",
    "start": 99.48,
    "end": 100.82,
    "text": "trở về ba năm trước"
  },
  {
    "id": "trans_44",
    "start": 100.82,
    "end": 102.64,
    "text": "vào ngày ném cầu kén chồng"
  },
  {
    "id": "trans_45",
    "start": 104.52,
    "end": 106.72,
    "text": "Tiểu thư, đến lượt cô ném cầu rồi"
  },
  {
    "id": "trans_46",
    "start": 108.74,
    "end": 109.66,
    "text": "Thẩm Vân Kiều"
  },
  {
    "id": "trans_47",
    "start": 110.8,
    "end": 111.58,
    "text": "Chị"
  },
  {
    "id": "trans_48",
    "start": 111.58,
    "end": 113.24,
    "text": "Muội không thể để tỷ ném trước được"
  },
  {
    "id": "trans_49",
    "start": 113.24,
    "end": 114.6,
    "text": "trước là Thẩm Vân Kiều"
  },
  {
    "id": "trans_50",
    "start": 114.6,
    "end": 115.8,
    "text": "Cô ta để ta ném cầu trước"
  },
  {
    "id": "trans_51",
    "start": 115.8,
    "end": 117.02,
    "text": "Còn đưa đẩy đủ kiểu"
  },
  {
    "id": "trans_52",
    "start": 117.94,
    "end": 118.76,
    "text": "Bây giờ"
  },
  {
    "id": "trans_53",
    "start": 119.46,
    "end": 121.8,
    "text": "xem ra Thẩm Vân Kiều cũng đã trùng sinh"
  },
  {
    "id": "trans_54",
    "start": 121.8,
    "end": 122.28,
    "text": "Tốt lắm"
  },
  {
    "id": "trans_55",
    "start": 122.28,
    "end": 123.62,
    "text": "Muội trước đi"
  },
  {
    "id": "trans_56",
    "start": 124.539,
    "end": 124.94,
    "text": "Đưa ta"
  },
  {
    "id": "trans_57",
    "start": 125.88,
    "end": 126.28,
    "text": "Đưa ta"
  },
  {
    "id": "trans_58",
    "start": 126.28,
    "end": 126.6,
    "text": "Đưa ta"
  },
  {
    "id": "trans_59",
    "start": 126.6,
    "end": 128.479,
    "text": "Ai nhặt được"
  },
  {
    "id": "trans_60",
    "start": 128.479,
    "end": 129.16,
    "text": "Ai nhặt được"
  },
  {
    "id": "trans_61",
    "start": 129.16,
    "end": 129.44,
    "text": "Đưa ta"
  },
  {
    "id": "trans_62",
    "start": 129.96,
    "end": 130.36,
    "text": "Đưa ta"
  },
  {
    "id": "trans_63",
    "start": 130.36,
    "end": 130.56,
    "text": "Đưa ta"
  },
  {
    "id": "trans_64",
    "start": 137.38,
    "end": 138.44,
    "text": "Kiếp này"
  },
  {
    "id": "trans_65",
    "start": 138.44,
    "end": 139.82,
    "text": "người gả cho Mộ Dung An"
  },
  {
    "id": "trans_66",
    "start": 139.82,
    "end": 140.68,
    "text": "chỉ có thể là ta"
  },
  {
    "id": "trans_67",
    "start": 147.7,
    "end": 148.02,
    "text": "Mộ Dung An"
  },
  {
    "id": "trans_68",
    "start": 148.02,
    "end": 148.6,
    "text": "Lão gia mau nhìn kìa"
  },
  {
    "id": "trans_69",
    "start": 148.6,
    "end": 149.48,
    "text": "Người nhặt cầu"
  },
  {
    "id": "trans_70",
    "start": 149.48,
    "end": 150.66,
    "text": "Chính là nhị công tử phủ Mộ Dung"
  },
  {
    "id": "trans_71",
    "start": 150.66,
    "end": 151.36,
    "text": "Là nàng ấy"
  },
  {
    "id": "trans_72",
    "start": 151.7,
    "end": 153.3,
    "text": "Là Mộ Dung An, nhị công tử phủ Mộ Dung"
  },
  {
    "id": "trans_73",
    "start": 153.3,
    "end": 155.08,
    "text": "Mộ Dung gia chính là tâm phúc của hoàng thất"
  },
  {
    "id": "trans_74",
    "start": 155.08,
    "end": 156.22,
    "text": "Đại công tử Mộ Dung Hách"
  },
  {
    "id": "trans_75",
    "start": 156.22,
    "end": 158.18,
    "text": "Mấy hôm trước vừa được bổ\nnhiệm làm Đại Tư Mã Thiếu Khanh"
  },
  {
    "id": "trans_76",
    "start": 158.54,
    "end": 159.36,
    "text": "Nếu như Thẩm gia"
  },
  {
    "id": "trans_77",
    "start": 159.36,
    "end": 160.56,
    "text": "có thể kết thân với phủ Mộ Dung"
  },
  {
    "id": "trans_78",
    "start": 160.56,
    "end": 162.18,
    "text": "Chúng ta chẳng phải sắp\nthành hoàng thân quốc thích sao"
  },
  {
    "id": "trans_79",
    "start": 162.56,
    "end": 163.42,
    "text": "Mộ Dung An"
  },
  {
    "id": "trans_80",
    "start": 164.28,
    "end": 164.92,
    "text": "Kiếp này"
  },
  {
    "id": "trans_81",
    "start": 164.92,
    "end": 166.44,
    "text": "cuối cùng ta cũng thay đổi được số phận rồi"
  },
  {
    "id": "trans_82",
    "start": 166.88,
    "end": 169.08,
    "text": "Ba năm sau, Mộ Dung An gia nhập triều đình"
  },
  {
    "id": "trans_83",
    "start": 169.08,
    "end": 169.94,
    "text": "còn ta"
  },
  {
    "id": "trans_84",
    "start": 169.94,
    "end": 171.94,
    "text": "sẽ trở thành mệnh phụ phu nhân tôn quý"
  },
  {
    "id": "trans_85",
    "start": 171.94,
    "end": 173.48,
    "text": "Thẩm Vân Kiều à Thẩm Vân Kiều"
  },
  {
    "id": "trans_86",
    "start": 173.48,
    "end": 174.78,
    "text": "Ngươi phí hết tâm cơ"
  },
  {
    "id": "trans_87",
    "start": 174.78,
    "end": 176.7,
    "text": "lại không biết mình đã\nmột chân giẫm vào ổ sói"
  }
]